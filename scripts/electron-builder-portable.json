{
  "appId": "com.breeze0305.ufriend",
  "productName": "UFriend",
  "executableName": "UFriend",
  "artifactName": "UFriend-${version}.${ext}",
  "compression": "normal",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "forceCodeSigning": false,
  "publish": null,
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "app/assets/ufriend.ico",
    "signAndEditExecutable": false,
    "signExecutable": false
  },
  "portable": {
    "requestExecutionLevel": "user",
    "unpackDirName": true,
    "useZip": true,
    "splashImage": null
  }
}
